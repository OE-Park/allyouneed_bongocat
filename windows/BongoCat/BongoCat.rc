// BongoCat resources (keep this file ASCII / UTF-8)
#pragma code_page(65001)
#include "resource.h"
#include <winres.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP     ICON    "app.ico"
IDI_SMALL   ICON    "small.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "BongoCat Native"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "BongoCat"
            VALUE "OriginalFilename", "BongoCat.exe"
            VALUE "ProductName", "BongoCat Native"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
